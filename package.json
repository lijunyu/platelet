{
  "name": "platelet",
  "version": "0.0.22",
  "description": "platelet live2D",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "patch": "npm version patch && git push origin master && git push origin --tags",
    "minor": "npm version minor && git push origin master && git push origin --tags",
    "major": "npm version major && git push origin master && git push origin --tags"
  },
  "build": {
    "productName": "Platelet",
    "appId": "org.amor.platelet",
    "publish": null,
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "directories": {
      "output": "build"
    },
    "files": [
      "assets/",
      "index.html",
      "setting.html",
      "main.js",
      "node_modules/",
      "package.json"
    ],
    "mac": {
      "icon": "build/icons/platelet.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icons/platelet.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icons"
    }
  },
  "repository": "https://github.com/amorist/platelet",
  "keywords": [
    "platelet"
  ],
  "author": {
    "name": "amorist",
    "email": "amorist@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "dark-mode": "^4.0.0",
    "electron-store": "^8.0.0"
  }
}
